# 环境变量文件（以后存数据库密码等敏感信息，永远不上传）
.env

# 依赖文件夹（体积大且能随时重装，Day 8 起会遇到）
node_modules/

# 构建产物（npm run build 生成，能随时重新打包，不提交）
dist/

# 临时打包产物（部署上传用的 zip，能随时重新打包，不提交）
*.zip

# 系统残留文件
.DS_Store
Thumbs.db

# 星露谷解包素材（版权归 ConcernedApe，仅本地开发占位 + LoRA 训练数据，绝不提交分发）
assets/sprites/
public/sprites/

# 发布版本快照（回滚演练用的 dist 备份，含版权素材，绝不提交）
release-snapshots/
